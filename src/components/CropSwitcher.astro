---
/**
 * Qualitative comparison: a full frame on the left and one zoomed crop per
 * method on the right. Clicking a crop highlights it; the layout is static
 * otherwise so it also works without JavaScript.
 */
import { Image } from "astro:assets";

interface Crop {
  src: ImageMetadata;
  label: string;
  ours?: boolean;
}

interface Props {
  scene: ImageMetadata;
  sceneAlt: string;
  crops: Crop[];
  caption?: string;
}

const { scene, sceneAlt, crops, caption } = Astro.props;
---

<div class="crop-switcher not-prose my-4 grid grid-cols-1 gap-3 md:grid-cols-[320px_minmax(0,1fr)]">
  <div class="overflow-hidden rounded-xl">
    <Image src={scene} alt={sceneAlt} widths={[320, 640, 960]} sizes="(min-width: 768px) 320px, 100vw" class="aspect-video h-full w-full object-cover" />
  </div>
  <div>
    <div class="grid grid-cols-3 gap-2 sm:grid-cols-6">
      {
        crops.map((c) => (
          <button
            type="button"
            class:list={[
              "crop overflow-hidden rounded-[10px] border-[3px] bg-black p-0 text-left",
              c.ours ? "border-nv" : "border-transparent",
            ]}
            data-ours={c.ours ? "1" : undefined}
          >
            <Image src={c.src} alt={c.label} widths={[220]} class="aspect-square w-full object-cover" />
            <span
              class:list={[
                "block bg-white py-1 text-center text-xs font-medium",
                c.ours ? "text-nv-ink" : "text-zinc-600",
              ]}
            >
              {c.label}
            </span>
          </button>
        ))
      }
    </div>
    {caption && <p class="mt-3 text-sm text-zinc-500">{caption}</p>}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".crop-switcher").forEach((root) => {
    const crops = [...root.querySelectorAll<HTMLButtonElement>(".crop")];
    root.addEventListener("click", (e) => {
      const c = (e.target as HTMLElement).closest<HTMLButtonElement>(".crop");
      if (!c) return;
      crops.forEach((x) => {
        const on = x === c;
        x.classList.toggle("border-nv", on);
        x.classList.toggle("border-transparent", !on);
        const label = x.querySelector("span");
        if (label) {
          label.classList.toggle("text-nv-ink", on);
          label.classList.toggle("text-zinc-600", !on);
        }
      });
    });
  });
</script>
