---
/**
 * Top bar in the style of NVIDIA Research lab pages: NVIDIA logo, lab name,
 * "NVIDIA Research", and optional in-page anchor links on wide screens.
 */
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  labName: string;
  labUrl: string;
  links?: NavLink[];
  /** Call-to-action pill at the right end of the bar, e.g. { label: "Try TTB", href: "<the demo>" }. Opens in a new tab.
   *  Shown from 40rem up; a phone's bar has no room for it and stays as it is. */
  cta?: NavLink;
}

const { labName, labUrl, links = [], cta } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
---

<nav
  class:list={[
    "site-nav not-prose sticky top-0 z-30 w-full border-b border-zinc-200 bg-white/95 backdrop-blur",
    cta && "has-cta",
  ]}
>
  <div
    class="mx-auto flex h-16 w-full max-w-[96rem] items-center gap-3 px-6 lg:px-10"
  >
    <a href="https://www.nvidia.com/" class="flex items-center no-underline">
      <img
        src={prefix + "nv-logo-black.webp"}
        width="125"
        height="24"
        alt="NVIDIA"
        decoding="async"
      />
    </a>
    <div class="mx-1 h-6 w-px bg-zinc-300"></div>
    <a
      href={labUrl}
      class="text-xs font-bold tracking-wide text-zinc-800 no-underline sm:text-sm md:text-base"
      >{labName}</a
    >
    <div class="mx-1 hidden h-6 w-px bg-zinc-300 sm:block"></div>
    <a
      href="https://www.nvidia.com/en-us/research/"
      class="hidden text-sm font-bold tracking-wide text-zinc-800 no-underline sm:block md:text-base"
      >NVIDIA Research</a
    >
    {
      links.length > 0 && (
        <div class="ml-auto hidden gap-6 text-sm font-medium text-zinc-600 lg:flex">
          {links.map((l) => (
            <a class="no-underline hover:text-nv-ink" href={l.href}>
              {l.label}
            </a>
          ))}
        </div>
      )
    }
    {
      cta && (
        <a
          href={cta.href}
          target="_blank"
          rel="noopener"
          class:list={[
            "nav-cta inline-flex shrink-0 items-center gap-1.5 rounded-full bg-zinc-900 px-4 py-2 text-sm font-medium whitespace-nowrap text-white no-underline transition-colors hover:bg-black max-sm:hidden",
            links.length > 0 ? "ml-auto lg:ml-6" : "ml-auto",
          ]}
        >
          <span>{cta.label}</span>
          <svg viewBox="0 0 24 24" class="h-[0.9em] w-[0.9em]" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M8.5 7H17v8.5" />
          </svg>
        </a>
      )
    }
  </div>
</nav>

<style>
  /* Just above the phone range the two names and the pill need tighter gaps to stay on one line. */
  @media (40rem <= width < 42rem) {
    .has-cta > div {
      gap: 0.5rem;
    }
  }
</style>
