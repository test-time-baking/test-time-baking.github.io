---
/**
 * Small explanatory card with an uppercase kicker, a title and free-form body.
 * `ours` tints the card in NVIDIA green.
 */
interface Props {
  kicker: string;
  title: string;
  ours?: boolean;
}
const { kicker, title, ours = false } = Astro.props;
---

<div
  class:list={[
    "rounded-2xl border p-5",
    ours ? "border-nv bg-nv-soft" : "border-zinc-200 bg-white",
  ]}
>
  <div
    class:list={[
      "text-xs font-bold tracking-[0.08em] uppercase",
      ours ? "text-nv-ink" : "text-zinc-500",
    ]}
  >
    {kicker}
  </div>
  <h4 class="mt-1.5 mb-1.5 text-lg font-semibold text-zinc-900">{title}</h4>
  <div
    class="card-body text-sm leading-relaxed text-zinc-600 [&_code]:rounded [&_code]:bg-black/5 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[13px] [&_p]:m-0"
  >
    <slot />
  </div>
</div>
