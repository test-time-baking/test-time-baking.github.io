---
/**
 * Screen recording of the live demo (the Gradio + viser app behind the Hugging
 * Face Space) with a link to open it. Video and poster live in /public.
 */
import { Icon } from "astro-icon/components";

interface Props {
  /** Path inside /public, e.g. "video/live-demo.mp4". */
  video: string;
  /** Path inside /public, e.g. "video/posters/live-demo.jpg". */
  poster: string;
  /** Where the button goes (the Hugging Face Space). */
  href: string;
  label?: string;
  caption?: string;
}

const { video, poster, href, label = "Open the demo on Hugging Face", caption } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
---

<figure class="live-demo not-prose my-0">
  <div class="relative aspect-video overflow-hidden rounded-[20px] bg-black ring-1 ring-black/5">
    <video
      class="h-full w-full object-cover"
      src={prefix + video}
      poster={prefix + poster}
      autoplay
      muted
      loop
      playsinline
      controls
      preload="metadata"></video>
  </div>
  <figcaption class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    {caption && <p class="m-0 max-w-[44rem] text-[0.95rem] leading-6 text-zinc-600">{caption}</p>}
    <a
      href={href}
      target="_blank"
      rel="noopener"
      class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-white px-4 py-2 text-[0.95rem] font-medium text-zinc-800 no-underline shadow-sm ring-1 ring-black/10 transition-colors hover:bg-black/5"
    >
      <Icon name="simple-icons:huggingface" class="h-[1.15em] w-[1.15em]" />
      <span>{label}</span>
    </a>
  </figcaption>
</figure>
