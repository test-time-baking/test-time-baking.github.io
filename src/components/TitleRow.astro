---
/**
 * Title block under the opening video: one left-aligned stack at the page's
 * middle width (`.mid-bleed`), the same width as the figures and videos below.
 * Order: title, subtitle, authors, affiliations and notes, the venue line,
 * then the link pills.
 */
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  /** Superscript after the name, e.g. "*1,2". */
  notes?: string[];
};

type Note = { symbol: string; text: string };

type Link = { url: string; name: string; icon?: string };

interface Props {
  title: string;
  /** Second line of the title, rendered smaller and in the text color. */
  subtitle?: string;
  /** Venue line, shown under the subtitle. */
  conference?: string;
  authors: Author[];
  /** Numbered affiliations, one line under the authors. */
  affiliations?: string[];
  notes?: Note[];
  links?: Link[];
}

const { title, subtitle, conference, authors, affiliations, notes, links } = Astro.props;
---

<header class="title-row mid-bleed not-prose mb-16">
  <h1 class="leading-[1.1]">
    <span class="block text-4xl font-bold tracking-tight text-nv sm:text-5xl">{title}</span>
    {
      subtitle && (
        <span class="mt-3 block text-xl leading-snug font-normal text-balance text-zinc-800 sm:text-[1.375rem]">
          {
            // Keep hyphenated words ("Decoder-only") on one line.
            subtitle.split(" ").map((word, i) => (
              <>
                {i > 0 && " "}
                {word.includes("-") ? <span class="whitespace-nowrap">{word}</span> : word}
              </>
            ))
          }
        </span>
      )
    }
  </h1>

  <div class="mt-7 text-[17px] leading-8 text-balance text-zinc-800">
    {
      authors.map((a) => (
        <span class="mr-5 inline-block whitespace-nowrap">
          {a.url ? (
            <a class="text-zinc-800 no-underline hover:text-nv-ink" href={a.url}>
              {a.name}
            </a>
          ) : (
            a.name
          )}
          {a.notes && <sup class="ml-0.5 text-xs text-zinc-500">{a.notes.join(",")}</sup>}
        </span>
      ))
    }
  </div>
  {
    (affiliations || notes) && (
      <div class="mt-2.5 flex flex-wrap gap-x-5 gap-y-0.5 text-sm text-zinc-500">
        {
          // prettier-ignore
          affiliations?.map((aff, i) => (
            <span><sup class="mr-0.5">{i + 1}</sup>{aff}</span>
          ))
        }
        {
          // prettier-ignore
          notes?.map((n) => (
            <span><sup class="mr-0.5">{n.symbol}</sup>{n.text}</span>
          ))
        }
      </div>
    )
  }

  {conference && <div class="mt-6 text-[15px] font-semibold text-zinc-900">{conference}</div>}
  {
    links && (
      <div class="mt-3 flex flex-wrap gap-2">
        {links.map((link) => (
          <a
            href={link.url}
            class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-[15px] font-medium text-zinc-800 no-underline shadow-sm ring-1 ring-black/10 transition-colors hover:bg-zinc-50"
          >
            {link.icon && <Icon name={link.icon} class="h-[1.1em] w-[1.1em]" />}
            <span>{link.name}</span>
          </a>
        ))}
      </div>
    )
  }
</header>
